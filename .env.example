# Application Settings
APP_NAME="Multimodal AI Operations Copilot"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# LLM & Multimodal Configuration
LLM_PROVIDER="gemini" # Options: gemini, mock, local
GEMINI_API_KEY="your-google-ai-studio-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Storage & Upload Limits
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=50
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]
ALLOWED_VIDEO_TYPES=["video/mp4", "video/quicktime", "video/x-msvideo"]
ALLOWED_DOC_TYPES=["application/pdf"]

# Video Processing Parameters
VIDEO_SAMPLE_FPS=1
VIDEO_MAX_DURATION_SEC=60
VIDEO_BLUR_THRESHOLD=100.0

# Logging
LOG_LEVEL="INFO"
